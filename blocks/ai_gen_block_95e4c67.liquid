{% doc %}
  @prompt
    Create a custom discount badge (e.g., "10% OFF") that appears on product cards when items are on sale. The badge should automatically calculate the discount percentage using the compare-at price and the current sale price. It should be visually prominent, positioned on the product image (top left or top right corner), and only display when a product has a compare-at price higher than the current price.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% if product.compare_at_price > product.price %}
  {% assign discount = product.compare_at_price | minus: product.price %}
  {% assign discount_percentage = discount | times: 100.0 | divided_by: product.compare_at_price | round %}

  {% style %}
    .ai-discount-badge-{{ ai_gen_id }} {
      display: block;
      width: {{ block.settings.desktop_width_percent }}%;
      max-width: 100%;
    }

    .ai-discount-badge-container-{{ ai_gen_id }} {
      position: relative;
      display: inline-block;
    }

    .ai-discount-badge-{{ ai_gen_id }} .ai-discount-badge-label-{{ ai_gen_id }} {
      position: absolute;
      {% if block.settings.position == 'top-left' %}
        top: {{ block.settings.offset_vertical }}px;
        left: {{ block.settings.offset_horizontal }}px;
      {% elsif block.settings.position == 'top-right' %}
        top: {{ block.settings.offset_vertical }}px;
        right: {{ block.settings.offset_horizontal }}px;
      {% elsif block.settings.position == 'bottom-left' %}
        bottom: {{ block.settings.offset_vertical }}px;
        left: {{ block.settings.offset_horizontal }}px;
      {% else %}
        bottom: {{ block.settings.offset_vertical }}px;
        right: {{ block.settings.offset_horizontal }}px;
      {% endif %}
      background-color: {{ block.settings.badge_background_color }};
      color: {{ block.settings.badge_text_color }};
      padding: {{ block.settings.padding_vertical }}px {{ block.settings.padding_horizontal }}px;
      border-radius: {{ block.settings.border_radius }}px;
      font-size: {{ block.settings.font_size }}px;
      font-weight: {{ block.settings.font_weight }};
      text-transform: {{ block.settings.text_transform }};
      z-index: 10;
      display: inline-block;
      line-height: 1.2;
      {% if block.settings.show_shadow %}
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
      {% endif %}
    }

    @media screen and (max-width: 749px) {
      .ai-discount-badge-{{ ai_gen_id }} .ai-discount-badge-label-{{ ai_gen_id }} {
        font-size: {{ block.settings.font_size | times: 0.85 }}px;
        padding: {{ block.settings.padding_vertical | times: 0.85 }}px {{ block.settings.padding_horizontal | times: 0.85 }}px;
      }
    }
  {% endstyle %}

  <div class="ai-discount-badge-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
    <div class="ai-discount-badge-container-{{ ai_gen_id }}">
      <span class="ai-discount-badge-label-{{ ai_gen_id }}">
        {% if block.settings.badge_format == 'percentage' %}
          {{ discount_percentage }}% {{ block.settings.badge_text }}
        {% elsif block.settings.badge_format == 'amount' %}
          {{ discount | money }} {{ block.settings.badge_text }}
        {% else %}
          {{ block.settings.badge_text }}
        {% endif %}
      </span>
    </div>
  </div>
{% endif %}

{% schema %}
{
  "name": "Discount badge",
  "settings": [
    {
      "type": "header",
      "content": "Badge content"
    },
    {
      "type": "select",
      "id": "badge_format",
      "label": "Display format",
      "options": [
        {
          "value": "percentage",
          "label": "Percentage (e.g., 10% OFF)"
        },
        {
          "value": "amount",
          "label": "Amount (e.g., ₹100 OFF)"
        },
        {
          "value": "text_only",
          "label": "Text only"
        }
      ],
      "default": "percentage"
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge text",
      "default": "OFF"
    },
    {
      "type": "header",
      "content": "Position"
    },
    {
      "type": "select",
      "id": "position",
      "label": "Badge position",
      "options": [
        {
          "value": "top-left",
          "label": "Top left"
        },
        {
          "value": "top-right",
          "label": "Top right"
        },
        {
          "value": "bottom-left",
          "label": "Bottom left"
        },
        {
          "value": "bottom-right",
          "label": "Bottom right"
        }
      ],
      "default": "top-left"
    },
    {
      "type": "range",
      "id": "offset_horizontal",
      "label": "Horizontal offset",
      "min": 0,
      "max": 50,
      "step": 5,
      "unit": "px",
      "default": 10
    },
    {
      "type": "range",
      "id": "offset_vertical",
      "label": "Vertical offset",
      "min": 0,
      "max": 50,
      "step": 5,
      "unit": "px",
      "default": 10
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color",
      "id": "badge_background_color",
      "label": "Background color",
      "default": "#c2185b"
    },
    {
      "type": "color",
      "id": "badge_text_color",
      "label": "Text color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "font_size",
      "label": "Font size",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "select",
      "id": "font_weight",
      "label": "Font weight",
      "options": [
        {
          "value": "400",
          "label": "Normal"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semi-bold"
        },
        {
          "value": "700",
          "label": "Bold"
        }
      ],
      "default": "700"
    },
    {
      "type": "select",
      "id": "text_transform",
      "label": "Text case",
      "options": [
        {
          "value": "none",
          "label": "Default"
        },
        {
          "value": "uppercase",
          "label": "Uppercase"
        }
      ],
      "default": "uppercase"
    },
    {
      "type": "range",
      "id": "padding_horizontal",
      "label": "Horizontal padding",
      "min": 4,
      "max": 24,
      "step": 2,
      "unit": "px",
      "default": 10
    },
    {
      "type": "range",
      "id": "padding_vertical",
      "label": "Vertical padding",
      "min": 2,
      "max": 16,
      "step": 2,
      "unit": "px",
      "default": 6
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Border radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "checkbox",
      "id": "show_shadow",
      "label": "Show shadow",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Discount badge"
    }
  ]
}
{% endschema %}