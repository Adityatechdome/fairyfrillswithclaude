{% doc %}
  @prompt
    editable collection bento grid where i can edit which image i need to showcase in front , over mobile also bento needs to be visible and also add feature to add two photos for desktop and mobile screens , add mobile width also , make it reponsive to all the screens right now at mobile view its not fit to the screen 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-bento-grid-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    max-width: 100%;
    padding: {{ block.settings.section_padding }}px 0;
    margin: 0 auto;
  }

  .ai-bento-grid__container-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    grid-template-rows: repeat(3, 1fr);
    gap: {{ block.settings.grid_gap }}px;
    width: 100%;
    height: {{ block.settings.grid_height }}px;
    max-width: {{ block.settings.desktop_width_percent }}%;
    margin: 0 auto;
  }

  .ai-bento-grid__item-{{ ai_gen_id }} {
    position: relative;
    overflow: hidden;
    border-radius: {{ block.settings.border_radius }}px;
    cursor: pointer;
    transition: transform 0.3s ease;
  }

  .ai-bento-grid__item-{{ ai_gen_id }}:hover {
    transform: scale(1.02);
  }

  .ai-bento-grid__item-{{ ai_gen_id }}--1 {
    grid-column: 1 / 3;
    grid-row: 1 / 3;
  }

  .ai-bento-grid__item-{{ ai_gen_id }}--2 {
    grid-column: 3 / 5;
    grid-row: 1 / 2;
  }

  .ai-bento-grid__item-{{ ai_gen_id }}--3 {
    grid-column: 3 / 4;
    grid-row: 2 / 4;
  }

  .ai-bento-grid__item-{{ ai_gen_id }}--4 {
    grid-column: 4 / 5;
    grid-row: 2 / 4;
  }

  .ai-bento-grid__item-{{ ai_gen_id }}--5 {
    grid-column: 1 / 3;
    grid-row: 3 / 4;
  }

  .ai-bento-grid__link-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    height: 100%;
    position: relative;
    text-decoration: none;
  }

  .ai-bento-grid__image-wrapper-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    position: relative;
  }

  .ai-bento-grid__image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .ai-bento-grid__image-{{ ai_gen_id }}--mobile {
    display: none;
  }

  .ai-bento-grid__placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: {{ block.settings.placeholder_bg_color }};
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-bento-grid__placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-bento-grid__overlay-{{ ai_gen_id }} {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    background: linear-gradient(to top, {{ block.settings.overlay_color }}, rgba(0, 0, 0, 0));
    padding: {{ block.settings.overlay_padding }}px;
    color: {{ block.settings.text_color }};
  }

  .ai-bento-grid__title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    font-weight: 600;
    margin: 0 0 4px 0;
    color: {{ block.settings.text_color }};
  }

  .ai-bento-grid__description-{{ ai_gen_id }} {
    font-size: {{ block.settings.description_size }}px;
    margin: 0;
    color: {{ block.settings.text_color }};
    opacity: 0.9;
  }

  @media screen and (max-width: 749px) {
    .ai-bento-grid-{{ ai_gen_id }} {
      padding: {{ block.settings.mobile_section_padding }}px 0;
    }

    .ai-bento-grid__container-{{ ai_gen_id }} {
      grid-template-columns: repeat(2, 1fr);
      grid-template-rows: auto;
      height: auto;
      gap: {{ block.settings.mobile_grid_gap }}px;
      max-width: {{ block.settings.mobile_width_percent }}%;
      padding: 0 {{ block.settings.mobile_horizontal_padding }}px;
    }

    .ai-bento-grid__item-{{ ai_gen_id }} {
      min-height: {{ block.settings.mobile_item_height }}px;
    }

    .ai-bento-grid__item-{{ ai_gen_id }}:hover {
      transform: none;
    }

    .ai-bento-grid__item-{{ ai_gen_id }}--1 {
      grid-column: 1 / 3;
      grid-row: auto;
      min-height: {{ block.settings.mobile_large_item_height }}px;
    }

    .ai-bento-grid__item-{{ ai_gen_id }}--2 {
      grid-column: 1 / 2;
      grid-row: auto;
    }

    .ai-bento-grid__item-{{ ai_gen_id }}--3 {
      grid-column: 2 / 3;
      grid-row: auto;
    }

    .ai-bento-grid__item-{{ ai_gen_id }}--4 {
      grid-column: 1 / 2;
      grid-row: auto;
    }

    .ai-bento-grid__item-{{ ai_gen_id }}--5 {
      grid-column: 2 / 3;
      grid-row: auto;
    }

    .ai-bento-grid__image-{{ ai_gen_id }}--desktop {
      display: none;
    }

    .ai-bento-grid__image-{{ ai_gen_id }}--mobile {
      display: block;
    }

    .ai-bento-grid__overlay-{{ ai_gen_id }} {
      padding: {{ block.settings.mobile_overlay_padding }}px;
    }

    .ai-bento-grid__title-{{ ai_gen_id }} {
      font-size: {{ block.settings.mobile_title_size }}px;
    }

    .ai-bento-grid__description-{{ ai_gen_id }} {
      font-size: {{ block.settings.mobile_description_size }}px;
    }
  }
{% endstyle %}

<collection-bento-grid-{{ ai_gen_id }}
  class="ai-bento-grid-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-bento-grid__container-{{ ai_gen_id }}">
    {% for i in (1..5) %}
      {% liquid
        assign collection_key = 'collection_' | append: i
        assign desktop_image_key = 'collection_' | append: i | append: '_desktop_image'
        assign mobile_image_key = 'collection_' | append: i | append: '_mobile_image'
        assign collection = block.settings[collection_key]
        assign desktop_image = block.settings[desktop_image_key]
        assign mobile_image = block.settings[mobile_image_key]
      %}

      <div class="ai-bento-grid__item-{{ ai_gen_id }} ai-bento-grid__item-{{ ai_gen_id }}--{{ i }}">
        {% if collection != blank %}
          <a href="{{ collection.url }}" class="ai-bento-grid__link-{{ ai_gen_id }}">
            <div class="ai-bento-grid__image-wrapper-{{ ai_gen_id }}">
              {% if desktop_image != blank %}
                <img
                  src="{{ desktop_image | image_url: width: 1000 }}"
                  alt="{{ desktop_image.alt | escape }}"
                  loading="lazy"
                  width="{{ desktop_image.width }}"
                  height="{{ desktop_image.height }}"
                  class="ai-bento-grid__image-{{ ai_gen_id }} ai-bento-grid__image-{{ ai_gen_id }}--desktop"
                >
              {% elsif collection.featured_image %}
                <img
                  src="{{ collection.featured_image | image_url: width: 1000 }}"
                  alt="{{ collection.featured_image.alt | escape }}"
                  loading="lazy"
                  width="{{ collection.featured_image.width }}"
                  height="{{ collection.featured_image.height }}"
                  class="ai-bento-grid__image-{{ ai_gen_id }} ai-bento-grid__image-{{ ai_gen_id }}--desktop"
                >
              {% else %}
                <div class="ai-bento-grid__placeholder-{{ ai_gen_id }} ai-bento-grid__image-{{ ai_gen_id }}--desktop">
                  {{ 'collection-apparel-1' | placeholder_svg_tag }}
                </div>
              {% endif %}

              {% if mobile_image != blank %}
                <img
                  src="{{ mobile_image | image_url: width: 800 }}"
                  alt="{{ mobile_image.alt | escape }}"
                  loading="lazy"
                  width="{{ mobile_image.width }}"
                  height="{{ mobile_image.height }}"
                  class="ai-bento-grid__image-{{ ai_gen_id }} ai-bento-grid__image-{{ ai_gen_id }}--mobile"
                >
              {% elsif desktop_image != blank %}
                <img
                  src="{{ desktop_image | image_url: width: 800 }}"
                  alt="{{ desktop_image.alt | escape }}"
                  loading="lazy"
                  width="{{ desktop_image.width }}"
                  height="{{ desktop_image.height }}"
                  class="ai-bento-grid__image-{{ ai_gen_id }} ai-bento-grid__image-{{ ai_gen_id }}--mobile"
                >
              {% elsif collection.featured_image %}
                <img
                  src="{{ collection.featured_image | image_url: width: 800 }}"
                  alt="{{ collection.featured_image.alt | escape }}"
                  loading="lazy"
                  width="{{ collection.featured_image.width }}"
                  height="{{ collection.featured_image.height }}"
                  class="ai-bento-grid__image-{{ ai_gen_id }} ai-bento-grid__image-{{ ai_gen_id }}--mobile"
                >
              {% else %}
                <div class="ai-bento-grid__placeholder-{{ ai_gen_id }} ai-bento-grid__image-{{ ai_gen_id }}--mobile">
                  {{ 'collection-apparel-1' | placeholder_svg_tag }}
                </div>
              {% endif %}
            </div>

            {% if block.settings.show_overlay %}
              <div class="ai-bento-grid__overlay-{{ ai_gen_id }}">
                <h3 class="ai-bento-grid__title-{{ ai_gen_id }}">{{ collection.title }}</h3>
                {% if block.settings.show_description and collection.description != blank %}
                  <p class="ai-bento-grid__description-{{ ai_gen_id }}">
                    {{ collection.description | strip_html | truncate: 80 }}
                  </p>
                {% endif %}
              </div>
            {% endif %}
          </a>
        {% else %}
          <div class="ai-bento-grid__link-{{ ai_gen_id }}">
            <div class="ai-bento-grid__image-wrapper-{{ ai_gen_id }}">
              {% if desktop_image != blank %}
                <img
                  src="{{ desktop_image | image_url: width: 1000 }}"
                  alt="{{ desktop_image.alt | escape }}"
                  loading="lazy"
                  width="{{ desktop_image.width }}"
                  height="{{ desktop_image.height }}"
                  class="ai-bento-grid__image-{{ ai_gen_id }} ai-bento-grid__image-{{ ai_gen_id }}--desktop"
                >
              {% else %}
                <div class="ai-bento-grid__placeholder-{{ ai_gen_id }} ai-bento-grid__image-{{ ai_gen_id }}--desktop">
                  {{ 'collection-apparel-1' | placeholder_svg_tag }}
                </div>
              {% endif %}

              {% if mobile_image != blank %}
                <img
                  src="{{ mobile_image | image_url: width: 800 }}"
                  alt="{{ mobile_image.alt | escape }}"
                  loading="lazy"
                  width="{{ mobile_image.width }}"
                  height="{{ mobile_image.height }}"
                  class="ai-bento-grid__image-{{ ai_gen_id }} ai-bento-grid__image-{{ ai_gen_id }}--mobile"
                >
              {% elsif desktop_image != blank %}
                <img
                  src="{{ desktop_image | image_url: width: 800 }}"
                  alt="{{ desktop_image.alt | escape }}"
                  loading="lazy"
                  width="{{ desktop_image.width }}"
                  height="{{ desktop_image.height }}"
                  class="ai-bento-grid__image-{{ ai_gen_id }} ai-bento-grid__image-{{ ai_gen_id }}--mobile"
                >
              {% else %}
                <div class="ai-bento-grid__placeholder-{{ ai_gen_id }} ai-bento-grid__image-{{ ai_gen_id }}--mobile">
                  {{ 'collection-apparel-1' | placeholder_svg_tag }}
                </div>
              {% endif %}
            </div>

            {% if block.settings.show_overlay %}
              <div class="ai-bento-grid__overlay-{{ ai_gen_id }}">
                <h3 class="ai-bento-grid__title-{{ ai_gen_id }}">Collection {{ i }}</h3>
              </div>
            {% endif %}
          </div>
        {% endif %}
      </div>
    {% endfor %}
  </div>
</collection-bento-grid-{{ ai_gen_id }}>

<script>
  (function() {
    class CollectionBentoGrid{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.items = this.querySelectorAll('.ai-bento-grid__item-{{ ai_gen_id }}');
      }
    }

    customElements.define('collection-bento-grid-{{ ai_gen_id }}', CollectionBentoGrid{{ ai_gen_id }});
  })();
</script>

