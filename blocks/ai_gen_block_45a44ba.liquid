{% doc %}
  @prompt
    Create a continuously scrolling marquee/ticker announcement bar that displays announcements in an infinite horizontal scroll loop, similar to a news ticker. The text should scroll smoothly from right to left without stopping, creating a seamless looping effect. It should support multiple announcement messages. The scroll speed setting should have a range from 0 to 200. Make it full width across all screen sizes. Place it under the header section.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-marquee-ticker-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    overflow: hidden;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.padding_vertical }}px 0;
    position: relative;
  }

  .ai-marquee-ticker-track-{{ ai_gen_id }} {
    display: flex;
    width: max-content;
    animation: ai-marquee-scroll-{{ ai_gen_id }} {{ block.settings.scroll_speed }}s linear infinite;
  }

  .ai-marquee-ticker-content-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    white-space: nowrap;
  }

  .ai-marquee-ticker-item-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    padding: 0 {{ block.settings.item_spacing }}px;
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.font_size }}px;
  }

  .ai-marquee-ticker-separator-{{ ai_gen_id }} {
    display: inline-block;
    width: {{ block.settings.separator_size }}px;
    height: {{ block.settings.separator_size }}px;
    background-color: {{ block.settings.separator_color }};
    border-radius: 50%;
    margin: 0 {{ block.settings.item_spacing }}px;
  }

  @keyframes ai-marquee-scroll-{{ ai_gen_id }} {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }

  .ai-marquee-ticker-{{ ai_gen_id }}:hover .ai-marquee-ticker-track-{{ ai_gen_id }} {
    {% if block.settings.pause_on_hover %}
      animation-play-state: paused;
    {% endif %}
  }
{% endstyle %}

<marquee-ticker-{{ ai_gen_id }} class="ai-marquee-ticker-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-marquee-ticker-track-{{ ai_gen_id }}">
    <div class="ai-marquee-ticker-content-{{ ai_gen_id }}">
      {% for i in (1..3) %}
        {% liquid
          assign message_key = 'message_' | append: i
          assign message = block.settings[message_key]
        %}
        {% if message != blank %}
          <span class="ai-marquee-ticker-item-{{ ai_gen_id }}">{{ message }}</span>
          {% unless forloop.last %}
            <span class="ai-marquee-ticker-separator-{{ ai_gen_id }}"></span>
          {% endunless %}
        {% endif %}
      {% endfor %}
    </div>
    <div class="ai-marquee-ticker-content-{{ ai_gen_id }}">
      {% for i in (1..3) %}
        {% liquid
          assign message_key = 'message_' | append: i
          assign message = block.settings[message_key]
        %}
        {% if message != blank %}
          <span class="ai-marquee-ticker-item-{{ ai_gen_id }}">{{ message }}</span>
          {% unless forloop.last %}
            <span class="ai-marquee-ticker-separator-{{ ai_gen_id }}"></span>
          {% endunless %}
        {% endif %}
      {% endfor %}
    </div>
  </div>
</marquee-ticker-{{ ai_gen_id }}>

<script>
  (function() {
    class MarqueeTicker{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.adjustSpeed();
      }

      adjustSpeed() {
        const track = this.querySelector('.ai-marquee-ticker-track-{{ ai_gen_id }}');
        if (!track) return;

        const content = this.querySelector('.ai-marquee-ticker-content-{{ ai_gen_id }}');
        if (!content) return;

        const contentWidth = content.offsetWidth;
        const speed = {{ block.settings.scroll_speed }};
        
        if (contentWidth > 0) {
          track.style.animationDuration = speed + 's';
        }
      }
    }

    customElements.define('marquee-ticker-{{ ai_gen_id }}', MarqueeTicker{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Announcement ticker",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Messages"
    },
    {
      "type": "text",
      "id": "message_1",
      "label": "Message 1",
      "default": "Free shipping on orders over ₹2000"
    },
    {
      "type": "text",
      "id": "message_2",
      "label": "Message 2",
      "default": "New arrivals every week"
    },
    {
      "type": "text",
      "id": "message_3",
      "label": "Message 3",
      "default": "Shop now and save up to 30%"
    },
    {
      "type": "header",
      "content": "Animation"
    },
    {
      "type": "range",
      "id": "scroll_speed",
      "label": "Scroll speed",
      "min": 10,
      "max": 200,
      "step": 10,
      "unit": "s",
      "default": 30,
      "info": "Lower values = faster scroll"
    },
    {
      "type": "checkbox",
      "id": "pause_on_hover",
      "label": "Pause on hover",
      "default": true
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#c2185b"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "font_size",
      "label": "Font size",
      "min": 10,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "padding_vertical",
      "label": "Vertical padding",
      "min": 5,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "item_spacing",
      "label": "Item spacing",
      "min": 10,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 40
    },
    {
      "type": "header",
      "content": "Separator"
    },
    {
      "type": "color",
      "id": "separator_color",
      "label": "Separator color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "separator_size",
      "label": "Separator size",
      "min": 2,
      "max": 10,
      "step": 1,
      "unit": "px",
      "default": 4
    }
  ],
  "presets": [
    {
      "name": "Announcement ticker"
    }
  ]
}
{% endschema %}